# Chave da API do Google Gemini (SDK google-genai)
GEMINI_API_KEY=

# Chave da API da OpenRouter (fallback quando a cota do Gemini esgotar)
OPENROUTER_API_KEY=

# Token de acesso pessoal do GitHub (escopo "repo"), usado para clonar e dar
# git push no Vault. So e necessario em producao (Docker/Render) — em dev
# local o git ja usa suas credenciais configuradas na maquina.
GITHUB_TOKEN=

# Repositorio do Vault do Obsidian no GitHub, no formato usuario/nome-do-repo
# (ex: Bernardoeleuterio/meu-obsidian-vault). So usado em producao, para o
# entrypoint.sh clonar o Vault dentro do container.
GITHUB_REPO=

# Caminho do Vault do Obsidian. Em dev local, o caminho da pasta do Obsidian
# no seu PC. Em producao (Docker/Render), use /app/vault — e o caminho onde
# o entrypoint.sh clona o Vault a partir do GITHUB_REPO.
OBSIDIAN_VAULT_PATH=

# Token de acesso proprio do KORA (OBRIGATORIO). Sem ele, todas as rotas
# protegidas recusam acesso. Gere um forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KORA_ACCESS_TOKEN=

# Porta do servidor FastAPI
PORT=8000

# Pastas do Vault que o assistente nunca le/escreve/lista/busca (separadas por virgula).
# Se nao definido, o padrao e "Pessoal".
VAULT_PASTAS_BLOQUEADAS=Pessoal

# Credenciais OAuth do Google Agenda (Etapa 19). GOOGLE_CLIENT_ID/SECRET vem da
# credencial "Desktop app" criada no Google Cloud Console (console.cloud.google.com).
# GOOGLE_REFRESH_TOKEN e gerado uma unica vez rodando
# `python scripts/autorizar_google_agenda.py` localmente, com CLIENT_ID/SECRET
# ja preenchidos aqui. Sem essas 3 variaveis, as ferramentas de agenda ficam
# indisponiveis (falha explicita, nao quebra o resto do KORA).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
