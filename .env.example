# Chave da API do Google Gemini (SDK google-genai)
GEMINI_API_KEY=

# Chave da API da OpenRouter (fallback quando a cota do Gemini esgotar)
OPENROUTER_API_KEY=

# Token de acesso pessoal do GitHub (usado para git push nas notas do Vault)
GITHUB_TOKEN=

# Repositorio do Vault do Obsidian no GitHub (ex: usuario/nome-do-repo)
GITHUB_REPO=

# Caminho local do Vault do Obsidian (clonado a partir do GITHUB_REPO)
OBSIDIAN_VAULT_PATH=

# Token de acesso proprio do KORA, usado para proteger o servidor
KORA_ACCESS_TOKEN=

# Porta do servidor FastAPI
PORT=8000

# Pastas do Vault que o assistente nunca le/escreve/lista/busca (separadas por virgula).
# Se nao definido, o padrao e "Pessoal".
VAULT_PASTAS_BLOQUEADAS=Pessoal
